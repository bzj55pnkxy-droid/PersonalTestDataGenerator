      ]
    },
    {
      "name": "Bulk count: valid (2-100)",
      "description": "Section 2, valid partition 2-100.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Section 2: a valid count returns exactly that many complete persons. Field formats are checked by the collection script.",
              "const count = Number(pm.request.url.query.get('count'));",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('returns exactly ' + count + ' persons', () => pm.expect(pm.response.json()).to.be.an('array').with.lengthOf(count));",
              "pm.test('every person has all fields', () => pm.response.json().forEach((p, i) => {",
              "    pm.expect(Object.keys(p), 'person ' + i).to.have.members([\"cpr\", \"firstName\", \"lastName\", \"gender\", \"birthDate\", \"address\", \"phoneNumber\"]);",
              "    pm.expect(Object.keys(p.address), 'person ' + i + ' address').to.have.members([\"street\", \"number\", \"floor\", \"door\", \"postalCode\", \"townName\"]);",
              "}));"
            ]
          }
        }
      ],
