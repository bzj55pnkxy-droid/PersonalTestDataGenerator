              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('fields: cpr, firstName, lastName, gender, birthDate, address, phoneNumber', () => pm.expect(Object.keys(pm.response.json())).to.have.members([\"cpr\", \"firstName\", \"lastName\", \"gender\", \"birthDate\", \"address\", \"phoneNumber\"]));",
                  "pm.test('address fields: street, number, floor, door, postalCode, townName', () => pm.expect(Object.keys(pm.response.json().address)).to.have.members([\"street\", \"number\", \"floor\", \"door\", \"postalCode\", \"townName\"]));"
                ]
              }
            }
          ]
