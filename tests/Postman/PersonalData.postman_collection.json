      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Section 2, A1: an invalid count gives 400 with validation problem details naming count.",
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('problem details with an error for count', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "    pm.expect(pm.response.json().errors).to.have.property('count');",
              "});"
            ]
          }
        }
      ],
