      "index": null,
      "roundness": null,
      "seed": 1580,
      "version": 1,
      "versionNonce": 1689506553,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794226709360,
      "link": null,
      "locked": false,
      "text": "Ved output vises 0 som \"000\", 1 som \"001\", 500 som \"500\" og 999 som \"999\".",
      "originalText": "Ved output vises 0 som \"000\", 1 som \"001\", 500 som \"500\" og 999 som \"999\".",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cpr-length-6490913d-51c7-4597-947f-9e9f4387b2ac",
      "type": "text",
      "x": 55,
      "y": 4332.75,
      "width": 746.64,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "stage-cpr-free-digits-d14fb049-cbde-49f8-a8f8-88fb3083fe97"
      ],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1581,
      "version": 1,
      "versionNonce": 1691134461,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794226709360,
      "link": null,
      "locked": false,
      "text": "Ugyldige værdier som -1 og 1000 kan ikke samtidig være præcis tre cifre.\nDe er numeriske fejloutputs, ikke isolerede formatkorrekte CPR-felter.",
      "originalText": "Ugyldige værdier som -1 og 1000 kan ikke samtidig være præcis tre cifre.\nDe er numeriske fejloutputs, ikke isolerede formatkorrekte CPR-felter.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
